# TensorForge API engine: environment template.
# Copy to `.env` and fill in your values:   cp .env.example .env
# `.env` holds the real API key: NEVER commit it. Only this example file belongs in git.
#
# Used by:
#   Docker:  docker run --env-file app/server/.env -p 8000:8000 tensorforge-api
#   venv:    uvicorn tfengine.main:app --env-file .env --port 8000
#   tests:   python scripts/smoke_test.py   (reads API_KEY and BASE_URL from here)
# Format: plain KEY=value lines, no quotes, no `export` (Docker's --env-file does not strip them).

# Required: the evaluation key emailed to the team leader. Empty -> every protected endpoint returns 401.
API_KEY=replace-with-your-api-key

# Where scripts/smoke_test.py sends requests (local container, or the hosted HTTPS URL). Ignored by the server.
BASE_URL=http://localhost:8000

# Optional: browser origins allowed to call the API (the web client in app/client, hosted on AWS Amplify).
# Comma-separated, exact origins, no trailing slash. Unset = CORS off (curl / the evaluation harness never need it).
# CORS_ORIGINS=https://main.<app-id>.amplifyapp.com,http://localhost:5173

# Optional server settings (defaults shown; uncomment to change).
# ONNX_THREADS=2
# JOB_CHUNK_SIZE=2
# MAX_RUNNING_JOBS=1
# MAX_QUEUED_JOBS=3
# JOB_RETENTION_S=21600
# HEARTBEAT_STALE_S=30
# PREDICT_READY_TIMEOUT_S=60
# LOG_LEVEL=INFO
#
# Paths: the Docker image already sets these (/app/model, /app/data). Only set them for venv runs
# if you want something other than the repo defaults (training/models/winner, app/server/var).
# MODEL_DIR=../../training/models/winner
# DATA_DIR=./var
