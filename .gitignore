# TensorForge 2.0: what stays off the remote.
# Note: gitignore has no inline comments, so every comment sits on its own line.

# ---- Local reference material ---------------------------------------------------------
# Organizer PDF, dataset and team planning notes: kept locally only.
# The API contract the code needs is copied into app/server/contract/.
/Resources/

# ---- Secrets --------------------------------------------------------------------------
# Real API key lives in .env; only the template is committed.
.env
.env.*
!.env.example

# ---- Python environments, caches, test output -----------------------------------------
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
.ipynb_checkpoints/

# ---- Web client (app/client) ----------------------------------------------------------
# Dependencies and the build output: recreated by `npm ci && npm run build` (the Docker image builds it itself).
node_modules/
app/client/dist/
# Large manual-test files, generated on demand by app/client/test-data/make-test-files.mjs.
app/client/test-data/08_big_job.csv
app/client/test-data/09_too_many.csv

# ---- Runtime data ---------------------------------------------------------------------
# SQLite job store created by local (venv) runs of the API; the container keeps it in /app/data.
app/server/var/
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm
*.log

# ---- Training artifacts ---------------------------------------------------------------
# Competition dataset + processed splits: not redistributed (see training/README.md for where to put them).
training/data/
# Checkpoints (1+ GB each) and intermediate ONNX exports: reproducible from the notebooks, archived on Drive.
training/checkpoints/
training/models/staging/
*.pt
*.joblib
# training/models/winner/ IS committed: the Docker image is built from it (model.onnx needs Git LFS).

# ---- OS / editor noise ----------------------------------------------------------------
# Windows "downloaded from the internet" markers created when copying files from Drive.
*:Zone.Identifier
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
